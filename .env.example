# 이 파일을 .env 로 복사해서 채운다. .env 는 git 에 올리지 않는다.

# Claude API (에이전트·평가용)
ANTHROPIC_API_KEY=

# 공공데이터포털 일반 인증키(Decoding) — 나라장터 입찰공고 OpenAPI 적재용 (선택)
DATA_GO_KR_SERVICE_KEY=

# Postgres (docker compose 가 같은 값을 읽는다)
POSTGRES_PASSWORD=change-me
AGENT_DB_PASSWORD=change-me-too
DATABASE_URL=postgresql://app:change-me@127.0.0.1:5432/publicdata
AGENT_DATABASE_URL=postgresql://agent_ro:change-me-too@127.0.0.1:5432/publicdata
